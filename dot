#!/bin/sh

set -eu

ROOT=$(cd -- "$(dirname -- "$0")" && pwd)
CHEZMOI=$(command -v chezmoi || true)

if [ -z "$CHEZMOI" ] && [ -x /opt/homebrew/bin/chezmoi ]; then
  CHEZMOI=/opt/homebrew/bin/chezmoi
fi
if [ -z "$CHEZMOI" ] && [ -x /usr/local/bin/chezmoi ]; then
  CHEZMOI=/usr/local/bin/chezmoi
fi

if [ -z "$CHEZMOI" ]; then
  printf 'error: chezmoi is not installed\n' >&2
  exit 1
fi

exec "$CHEZMOI" -S "$ROOT" "$@"
