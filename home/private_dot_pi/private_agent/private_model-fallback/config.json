{
  "version": 1,
  "enabled": true,
  "autoRetry": false,
  "rules": [
    {
      "name": "go-quota-or-auth",
      "matchProviders": ["opencode-go"],
      "statuses": [401, 402, 429],
      "cooldownMs": 18000000,
      "fallback": {"provider": "github-copilot", "model": "gpt-6-luna"}
    },
    {
      "name": "go-transient",
      "matchProviders": ["opencode-go"],
      "statuses": [500, 502, 503, 504, 529],
      "cooldownMs": 600000,
      "fallback": {"provider": "github-copilot", "model": "gpt-6-luna"}
    },
    {
      "name": "copilot-quota-or-auth",
      "matchProviders": ["github-copilot"],
      "statuses": [401, 402, 429],
      "cooldownMs": 18000000,
      "fallback": {"provider": "openai", "model": "gpt-6-luna"}
    },
    {
      "name": "copilot-transient",
      "matchProviders": ["github-copilot"],
      "statuses": [500, 502, 503, 504, 529],
      "cooldownMs": 600000,
      "fallback": {"provider": "openai", "model": "gpt-6-luna"}
    },
    {
      "name": "native-luna-quota-or-auth",
      "matchModels": [{"provider": "openai", "model": "gpt-6-luna"}],
      "statuses": [401, 402, 429],
      "cooldownMs": 18000000,
      "fallback": {"provider": "anthropic", "model": "claude-sonnet-5-5"}
    },
    {
      "name": "native-luna-transient",
      "matchModels": [{"provider": "openai", "model": "gpt-6-luna"}],
      "statuses": [500, 502, 503, 504, 529],
      "cooldownMs": 600000,
      "fallback": {"provider": "anthropic", "model": "claude-sonnet-5-5"}
    },
    {
      "name": "native-openai-quota-or-auth",
      "matchProviders": ["openai"],
      "statuses": [401, 402, 429],
      "cooldownMs": 18000000,
      "fallback": {"provider": "anthropic", "model": "claude-sonnet-5-5"}
    },
    {
      "name": "native-openai-transient",
      "matchProviders": ["openai"],
      "statuses": [500, 502, 503, 504, 529],
      "cooldownMs": 600000,
      "fallback": {"provider": "anthropic", "model": "claude-sonnet-5-5"}
    },
    {
      "name": "anthropic-haiku-quota-or-auth",
      "matchModels": [{"provider": "anthropic", "model": "claude-haiku-5-5"}],
      "statuses": [401, 402, 429],
      "cooldownMs": 18000000,
      "fallback": {"provider": "github-copilot", "model": "gpt-6-luna"}
    },
    {
      "name": "anthropic-haiku-transient",
      "matchModels": [{"provider": "anthropic", "model": "claude-haiku-5-5"}],
      "statuses": [500, 502, 503, 504, 529],
      "cooldownMs": 600000,
      "fallback": {"provider": "github-copilot", "model": "gpt-6-luna"}
    },
    {
      "name": "anthropic-quota-or-auth",
      "matchProviders": ["anthropic"],
      "statuses": [401, 402, 429],
      "cooldownMs": 18000000,
      "fallback": {"provider": "openai", "model": "gpt-6.1-sol"}
    },
    {
      "name": "anthropic-transient",
      "matchProviders": ["anthropic"],
      "statuses": [500, 502, 503, 504, 529],
      "cooldownMs": 600000,
      "fallback": {"provider": "openai", "model": "gpt-6.1-sol"}
    },
    {
      "name": "anthropic-api-quota-or-auth",
      "matchProviders": ["anthropic-api"],
      "statuses": [401, 402, 429],
      "cooldownMs": 18000000,
      "fallback": {"provider": "openai", "model": "gpt-6.1-sol"}
    },
    {
      "name": "anthropic-api-transient",
      "matchProviders": ["anthropic-api"],
      "statuses": [500, 502, 503, 504, 529],
      "cooldownMs": 600000,
      "fallback": {"provider": "openai", "model": "gpt-6.1-sol"}
    }
  ]
}
