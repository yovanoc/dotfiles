{
  "version": 1,
  "enabled": true,
  "autoRetry": true,
  "rules": [
    {
      "name": "opencode-gemini-quota-or-auth",
      "matchModels": [{ "provider": "opencode", "model": "gemini-3.8-flash" }],
      "statuses": [401, 402, 429],
      "cooldownMs": 18000000,
      "fallback": { "provider": "github-copilot", "model": "gemini-3.8-flash" }
    },
