{
  "mcpServers": {
    "cachebro": {
      "command": "npx",
      "args": [
        "-y",
        "cachebro",
        "serve"
      ]
    },
    "gh_grep": {
      "url": "https://mcp.grep.app"
    },
    "mdn": {
      "url": "https://mcp.mdn.mozilla.net"
    },
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    }
  }
}
