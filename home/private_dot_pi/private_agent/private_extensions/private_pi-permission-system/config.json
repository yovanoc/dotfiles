{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",

  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": false,
  "doublePressToConfirm": true,
  "forwardingTimeoutMs": 600000,
  "piInfrastructureReadPaths": [
    "/opt/homebrew/**/@earendil-works/pi-coding-agent/**"
  ],

  "authorizerChain": ["model-judge"],

  "permission": {
    "*": "allow",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "read": "allow",
    "write": "deny",
    "edit": "deny",
    "bash": {
      "*": "allow",
      "rtk *": "allow",
      "rm -rf *": "deny",
      "sudo *": "ask",
      "rm -fr *": "ask",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "git clean*": "ask",
      "git checkout -- *": "ask",
      "git branch -D*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "jj git push*": "ask",
      "jj gp*": "ask",
      "gh * delete*": "ask",
      "gh * merge*": "ask",
      "glab * delete*": "ask",
      "glab * merge*": "ask"
    },
    "mcp": {
      "*": "ask",
      "mcp_status": "allow"
    },
    "skill": { "*": "allow" },
    "external_directory": {
      "*": "ask",
      "~/.cargo/registry/*": "allow",
      "~/Projects/big-leaf/.worktrees/*": "allow",
      "~/.agents/*": "allow",
      "~/.pi/*": "allow"
    }
  }
}
