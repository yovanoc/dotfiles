{
  "mcpServers": {
    "cachebro": {
      "command": "npx",
      "args": [
        "-y",
        "cachebro",
        "serve"
      ]
    },
    "gh_grep": {
      "url": "https://mcp.grep.app"
    },
    "mdn": {
      "url": "https://mcp.mdn.mozilla.net"
    },
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "cloudflare-docs": {
      "url": "https://docs.mcp.cloudflare.com/mcp"
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "oauth": {},
      "disabled": true
    }
