{{- $name := promptStringOnce . "name" "Full name" "Christopher Yovanovitch" -}}
{{- $email := promptStringOnce . "email" "Git email" "yovano_c@outlook.com" -}}
{{- $signingkey := promptStringOnce . "signingkey" "GPG signing key (empty to disable commit signing)" "0266EAC0A0CCF969E35FB8A2D351227705396FF0" -}}

# Generated by `chezmoi init` from home/.chezmoi.toml.tmpl.
# Answers are stored here, per machine, and never committed.
# sourceDir lets `chezmoi` run from any directory without a --source flag.
sourceDir = {{ .chezmoi.workingTree | quote }}

[data]
name = {{ $name | quote }}
email = {{ $email | quote }}
signingkey = {{ $signingkey | quote }}

[diff]
pager = "delta"

[merge]
command = "nvim"
args = ["-d"]
